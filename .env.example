# Copy to .env.local and fill in. Public values only (Supabase > Project Settings > API Keys).
# On Vercel, add the same names under Settings > Environment Variables (Preview + Production).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# Server only (no NEXT_PUBLIC_ prefix): lets workspace owners create team accounts with a password.
# Supabase → Project Settings → API Keys → Secret keys. Never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=sb_secret_YOUR-KEY
